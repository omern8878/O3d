{
  "name": "@omern/o3d",
  "version": "1.0.0",
  "description": "Zero-copy Rust/WebAssembly + WebGPU instanced renderer: SceneTemplate, ECS views, dirty uploads, frustum culling and picking.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "webgpu",
    "webassembly",
    "wasm",
    "rust",
    "renderer",
    "ecs",
    "instancing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omern8878/O3d.git",
    "directory": "packages/templates"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-engine.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@webgpu/types": "^0.1.74",
    "typescript": "~6.0.2",
    "@engine/core": "*",
    "vite": "^8.3.0"
  }
}
